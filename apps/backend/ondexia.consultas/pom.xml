<?xml version="1.0" encoding="UTF-8"?>
<!--
  Consultas a fuentes publicas externas (DT-19).

  ══════════════════════════════════════════════════════════════════════════
  SIN SPRING, Y ES LA RAZON DE QUE SEA UN MODULO Y NO UNA RUTA MAS DE LA API.
  ══════════════════════════════════════════════════════════════════════════

  Esta Lambda existe porque la de la API no tiene salida a internet: esta en
  subred privada sin NAT, y darsela cuesta 32 USD/mes de NAT Gateway o 7,30 de
  endpoint de interfaz (DTE §4.8, DT-19). Esta va fuera de la VPC, donde salir
  es gratis.

  Y no lleva Spring a proposito. Un contenedor de Spring Boot arranca en varios
  segundos, y esta consulta ocurre mientras una persona espera con el cursor en
  un formulario de registro: el arranque en frio es tiempo que mira. Para dos
  peticiones HTTP y una firma, el contenedor no compra nada que compense eso.

  El precio es reescribir la fontaneria HTTP que en la API era RestClient. La
  logica —el vocabulario del padron, la cascada, la tabla de decision de que es
  reintentable— no depende de Spring y se mueve tal cual.

  Ver ondexia.docs/11-registro-de-empresa.md
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ondexia</groupId>
    <artifactId>ondexia-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ondexia-consultas</artifactId>
  <name>Ondexia — consultas externas</name>

  <dependencies>
    <!--
      El dominio, por Ruc y DatosDeRuc. Es la segunda razon de que el dominio sea
      un modulo aparte: aqui se construye el mismo objeto que la API consume, con
      la misma validacion del digito verificador, sin duplicar una linea.
    -->
    <dependency>
      <groupId>com.ondexia</groupId>
      <artifactId>ondexia-domain</artifactId>
    </dependency>

    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-core</artifactId>
      <version>${lambda-core.version}</version>
    </dependency>

    <!--
      No se usa aws-lambda-java-events. Para una sola ruta, el evento de la
      pasarela son cuatro campos y leerlos con Jackson es mas corto que traer un
      arbol de clases generadas para todos los servicios de AWS.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!--
      Donde viven las claves de los proveedores.
      Sin netty ni apache: en una Lambda que hace una llamada por arranque en
      frio, un cliente asincrono con su pool de hilos es peso muerto que se paga
      en tiempo de arranque. Mismo criterio que ondexia.api.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>ssm</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- No es un ejecutable de Spring Boot; el plugin no tiene nada que hacer. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <!-- Lambda necesita un jar con las dependencias dentro. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!--
                      Firmas de los jars originales. Al fusionar el contenido
                      dejan de cuadrar y la JVM aborta con SecurityException
                      («Invalid signature file digest») antes de ejecutar nada.
                    -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
