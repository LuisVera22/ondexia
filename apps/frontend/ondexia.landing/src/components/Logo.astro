---
/**
 * El logotipo, en línea y no como <img>.
 *
 * Dos motivos. Uno: es lo primero que se pinta, y una petición menos en la
 * portada se nota en el LCP. Dos: la variante para fondo oscuro solo cambia el
 * color del texto, y con dos archivos —logo.svg y logo-dark.svg, como en la
 * app— hay que mantener los dos sincronizados a mano.
 *
 * Los trazos son los mismos que ondexia.web/public/images/logo/logo.svg. Si el
 * logotipo cambia allá, cambia aquí.
 */
interface Props {
  /** Sobre índigo o sobre gris-950, donde el texto va en blanco. */
  claro?: boolean;
  ancho?: number;
  clase?: string;
}

const { claro = false, ancho = 148, clase = '' } = Astro.props;

const alto = Math.round((ancho * 32) / 154);
const colorTexto = claro ? '#ffffff' : '#101828';
---

<svg
  width={ancho}
  height={alto}
  viewBox="0 0 154 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Ondexia"
  class={clase}
>
  <path
    d="M0 8.42105C0 3.77023 3.77023 0 8.42105 0H23.5789C28.2298 0 32 3.77023 32 8.42105V23.5789C32 28.2298 28.2298 32 23.5789 32H8.42105C3.77023 32 0 28.2298 0 23.5789V8.42105Z"
    fill="#4F46E5"></path>
  <circle
    cx="16"
    cy="16"
    r="7.4"
    stroke="#FFFFFF"
    stroke-width="3"
    fill="none"
    stroke-dasharray="34 12.5"
    stroke-linecap="round"
    transform="rotate(-58 16 16)"></circle>
  <circle cx="21.9" cy="10.1" r="2.2" fill="#FFFFFF"></circle>
  <g
    stroke={colorTexto}
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  >
    <ellipse cx="48" cy="17" rx="5.4" ry="7"></ellipse>
    <path d="M59 24V10L69 24V10"></path>
    <path d="M75 24V10h3.5a7 7 0 0 1 0 14H75z"></path>
    <path d="M100 10H91V24H100M91 17H98"></path>
    <path d="M107 10L117 24M117 10L107 24"></path>
    <path d="M125 10V24"></path>
    <path d="M135 24L140 10L145 24M137 19H143"></path>
  </g>
</svg>
