---
const funciones = [
  {
    numero: '01', titulo: 'Atender una venta',
    descripcion: 'Encontrar bienes o servicios, seleccionar al cliente y completar la operación desde el punto de venta.',
    detalles: ['Notas de venta, boletas y facturas', 'Bienes y servicios en el mismo mostrador', 'Consulta del registro y vista de impresión'],
  },
  {
    numero: '02', titulo: 'Seguir los cobros',
    descripcion: 'Revisar los pagos registrados en la sesión de caja y cerrar la jornada con el arqueo.',
    detalles: ['Sesiones de caja por establecimiento', 'Registro de las formas de pago', 'Cierre con importes declarados'],
  },
  {
    numero: '03', titulo: 'Consultar las existencias',
    descripcion: 'Ver qué bienes hay en cada establecimiento y distinguirlos de los servicios que no manejan stock.',
    detalles: ['Catálogos separados de bienes y servicios', 'Clientes vinculados a la venta', 'Consulta de movimientos de almacén'],
  },
];
---

<section id="funciones" class="seccion-funciones seccion">
  <div class="contenedor">
    <div class="encabezado-seccion">
      <div>
        <p class="rotulo text-brand-600">El sistema</p>
        <h2 class="titulo-seccion">Para el trabajo<br />de todos los días.</h2>
      </div>
      <p class="introduccion-seccion">Desde atender en el mostrador hasta revisar el cierre de caja: cada tarea tiene un lugar en Ondexia.</p>
    </div>
    <div class="funciones">
      {funciones.map((funcion) => (
        <article class="funcion">
          <span class="numero-funcion" aria-hidden="true">{funcion.numero}</span>
          <h3>{funcion.titulo}</h3>
          <p>{funcion.descripcion}</p>
          <ul>{funcion.detalles.map((detalle) => <li>{detalle}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .seccion-funciones { background: var(--color-gray-25); }
  .funciones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-gray-300); }
  .funcion { padding: 34px 28px 0; border-left: 1px solid var(--color-gray-200); }
  .funcion:first-child { padding-left: 0; border-left: 0; }
  .funcion:last-child { padding-right: 0; }
  .numero-funcion { display: block; margin-bottom: 38px; font-size: 14px; color: var(--color-brand-600); font-weight: 500; }
  h3 { margin-bottom: 14px; font-size: 23px; line-height: 1.3; font-weight: 500; letter-spacing: -0.02em; }
  .funcion p { color: var(--color-gray-600); font-size: 16px; line-height: 1.65; }
  ul { margin-top: 27px; display: grid; gap: 12px; }
  li { padding-left: 15px; border-left: 2px solid var(--color-brand-200); font-size: 14px; line-height: 1.55; }
  @media (max-width: 767px) {
    .funciones { grid-template-columns: 1fr; }
    .funcion, .funcion:first-child, .funcion:last-child { padding: 27px 0; border-left: 0; border-bottom: 1px solid var(--color-gray-200); }
    .numero-funcion { margin-bottom: 17px; }
    ul { margin-top: 20px; }
  }
</style>
