---
const herramientas = [
  {titulo:'Punto de venta', detalle:'Seleccionar bienes y servicios, indicar el cliente y revisar el importe de la operación.', captura:'/capturas/venta-completa.png', alternativa:'Punto de venta con selección de bienes y servicios.'},
  {titulo:'Registro de ventas', detalle:'Consultar el documento y el detalle de una venta junto con sus pagos registrados.', captura:'/capturas/registro-completo.png', alternativa:'Detalle completo de una nota de venta registrada.'},
  {titulo:'Documentos', detalle:'Previsualizar la nota de venta completa y acceder a su impresión desde el registro.', captura:'/capturas/documento-completo.png', alternativa:'Previsualización de la nota de venta para impresión.'},
  {titulo:'Cobros', detalle:'Indicar formas de pago y revisar el saldo o el vuelto antes de registrar la venta.', captura:'/capturas/venta-completa.png', alternativa:'Pantalla de punto de venta con controles de cobro y vuelto.'},
];
---
<section id="funciones" class="seccion herramientas" aria-labelledby="titulo-herramientas" data-herramientas>
  <div class="contenedor">
    <div class="encabezado-herramientas">
      <p class="rotulo">De la atención al documento</p>
      <h2 id="titulo-herramientas" class="titulo-seccion">Herramientas para<br />la operación diaria.</h2>
      <p>Una vista de las tareas que se pueden realizar en Ondexia.</p>
    </div>
    <div class="carrusel-controles" data-carrusel-controles hidden>
      <button type="button" aria-label="Ver herramientas anteriores" data-anterior disabled>←</button>
      <button type="button" aria-label="Ver herramientas siguientes" data-siguiente>→</button>
    </div>
    <ul class="lista-herramientas" tabindex="0" aria-label="Herramientas de Ondexia" data-carrusel>
      {herramientas.map(herramienta => <li>
        <div><h3>{herramienta.titulo}</h3><p>{herramienta.detalle}</p></div>
        <div class="herramienta-vista">
          <img src={herramienta.captura} alt={herramienta.alternativa} width="1440" height="1000" loading="lazy" decoding="async" />
        </div>
      </li>)}
    </ul>
    <p class="nota-herramientas">Capturas del sistema · datos de demostración. La nota de venta es un documento interno.</p>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-herramientas]').forEach(seccion => {
    const carrusel = seccion.querySelector<HTMLElement>('[data-carrusel]');
    const anterior = seccion.querySelector<HTMLButtonElement>('[data-anterior]');
    const siguiente = seccion.querySelector<HTMLButtonElement>('[data-siguiente]');
    const controles = seccion.querySelector<HTMLElement>('[data-carrusel-controles]');
    if (!carrusel || !anterior || !siguiente || !controles) return;
    controles.hidden = false;
    const actualizar = () => {
      anterior.disabled = carrusel.scrollLeft <= 2;
      siguiente.disabled = carrusel.scrollLeft >= carrusel.scrollWidth - carrusel.clientWidth - 2;
    };
    const avanzar = (direccion: number) => {
      const tarjeta = carrusel.querySelector('li');
      const paso = tarjeta ? tarjeta.getBoundingClientRect().width + 20 : carrusel.clientWidth;
      carrusel.scrollBy({left: direccion * paso, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
    };
    anterior.addEventListener('click', () => avanzar(-1));
    siguiente.addEventListener('click', () => avanzar(1));
    carrusel.addEventListener('scroll', actualizar, {passive: true});
    window.addEventListener('resize', actualizar, {passive: true});
    actualizar();
  });
</script>
<style>
  [hidden] { display: none !important; }
  .encabezado-herramientas { text-align: center; }
  .encabezado-herramientas > p { color: var(--color-gray-600); margin: 20px auto; max-width: 600px; }
  .carrusel-controles { display: flex; justify-content: center; gap: 12px; margin: 26px 0; }
  button { width: 48px; height: 48px; border: 1px solid var(--color-gray-200); border-radius: var(--radius-base); background: white; font-size: 22px; font-family: system-ui, sans-serif; cursor: pointer; }
  button:disabled { opacity: .35; cursor: default; }
  button:hover:not(:disabled) { border-color: var(--color-brand-500); color: var(--color-brand-700); }
  .lista-herramientas { display: grid; grid-auto-flow: column; grid-auto-columns: 31%; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 4px; overscroll-behavior-x: contain; padding: 4px 4px 16px; margin: 28px 0 0; list-style: none; }
  li { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 44px; scroll-snap-align: start; border-radius: var(--radius-base); background: var(--color-gray-25); border: 1px solid var(--color-gray-100); padding: 28px 22px 20px; }
  h3 { font-size: 22px; font-weight: 500; margin-bottom: 12px; }
  li p { color: var(--color-gray-600); font-size: 15px; line-height: 1.7; }
  li img { width: 100%; height: auto; border: 1px solid var(--color-gray-200); border-radius: var(--radius-base); }
  .herramienta-vista { overflow: hidden; border-radius: var(--radius-base); }
  li img { transition: transform 700ms var(--ease-propia); }
  @media (hover: hover) { li:hover img { transform: scale(1.035); } }
  .nota-herramientas { margin-top: 16px; color: var(--color-gray-600); font-size: 12px; }
  @media (max-width: 1023px) { .lista-herramientas { grid-auto-columns: 46%; } }
  @media (max-width: 600px) { .lista-herramientas { grid-auto-columns: 86%; } li { padding: 24px 18px 16px; gap: 28px; } }
</style>
