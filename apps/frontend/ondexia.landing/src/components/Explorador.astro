---
import Cartel from './Cartel.astro';
const escenas = [
  {
    clave: 'venta',
    numero: '01',
    titulo: 'Preparar la venta',
    tituloCorto: 'Venta',
    descripcion: 'Seleccionar bienes y servicios y revisar el total antes de registrar la venta.',
    alternativa: 'Pantalla completa del punto de venta de Ondexia, con bienes y servicios, cliente, importes y cobro.',
    captura: '/capturas/venta-completa.png',
  },
  {
    clave: 'registro',
    numero: '02',
    titulo: 'Revisar el registro',
    tituloCorto: 'Registro',
    descripcion: 'Consultar el documento, el cliente y los pagos de la venta.',
    alternativa: 'Pantalla completa del registro de una nota de venta en Ondexia, con cliente, detalle, pagos e importe total.',
    captura: '/capturas/registro-completo.png',
  },
  {
    clave: 'documento',
    numero: '03',
    titulo: 'Previsualizar el documento',
    tituloCorto: 'Documento',
    descripcion: 'Revisar la nota de venta completa y acceder a su impresión.',
    alternativa: 'Pantalla completa de la previsualización de una nota de venta en Ondexia, con emisor, detalle e importe total.',
    captura: '/capturas/documento-completo.png',
  },
];
const rotuloCaptura = 'Capturas del sistema · datos de demostración';
---

<section class="explorador" aria-label="Presentación del sistema" data-explorador>
  <Cartel />
  <div id="explorar" class="explorador-interior">
    <div class="explorador-recorrido" data-recorrido hidden>
      <div class="recorrido-escenario" data-escenario>
        <div class="escenario-adornos" aria-hidden="true" data-adornos>
          {escenas.map((_escena, indice) => (
            <div class="adornos-grupo" data-adorno-grupo hidden={indice !== 0}>
              <div class="adorno adorno-izquierdo">
                <span class="adorno-numero">0{indice + 1}</span>
                <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
                  {indice === 0 ? <><path d="M20 30 50 15 80 30 50 45Z M20 30v40l30 15 30-15V30 M50 45v40 M35 22l30 15v17" /></>
                    : indice === 1 ? <><rect x="18" y="18" width="64" height="64" rx="6" /><path d="M30 35h40 M30 50h40 M30 65h25" /></>
                    : <><path d="M27 12h35l13 13v63H27Z M62 12v15h13 M37 42h28 M37 55h28 M37 68h18" /></>}
                </svg>
                <span>{['Bienes y servicios', 'Detalle de la operación', 'Nota de venta'][indice]}</span>
              </div>
              <div class="adorno adorno-derecho">
                <span class="adorno-etiqueta">{['Preparar', 'Consultar', 'Presentar'][indice]}</span>
                <strong>{['Revisar antes de registrar', 'Consultar lo registrado', 'Preparar la impresión'][indice]}</strong>
                <svg viewBox="0 0 220 85" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M5 65Q55 0 110 42T215 12" /><circle cx="110" cy="42" r="5" /></svg>
              </div>
            </div>
          ))}
        </div>
        <nav class="escenario-timeline" aria-label="Recorrido del sistema" data-timeline hidden>
          <p class="rotulo">Una venta. Todo su recorrido.</p>
          {escenas.map((escena, indice) => (
            <div class="timeline-paso">
              <div class="timeline-linea" aria-hidden="true"><span data-barra></span></div>
              <h2><button type="button" data-paso aria-expanded={indice === 0 ? 'true' : 'false'} aria-controls={`detalle-${escena.clave}`}>
                <span>{escena.numero}</span>{escena.tituloCorto}
              </button></h2>
              <div id={`detalle-${escena.clave}`} data-detalle hidden={indice !== 0}>
                <h3>{escena.titulo}</h3><p>{escena.descripcion}</p>
              </div>
            </div>
          ))}
        </nav>
        <div class="escenario-composicion" data-composicion>
          <svg class="escenario-contorno" viewBox="0 0 1440 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M80 40 Q720 0 1360 40 Q1440 500 1360 960 Q720 1000 80 960 Q0 500 80 40 Z" data-contorno /></svg>
          <div class="escenario-marco" role="img" aria-label={escenas[0].alternativa} data-marco data-visual>
            {escenas.map((escena) => <img class="escenario-capa" src={escena.captura} alt="" aria-hidden="true" width="1440" height="1000" decoding="async" data-capa />)}
          </div>
          <div class="escenario-informacion">
            <p class="captura-rotulo">{rotuloCaptura}</p>
            <div class="escena-acciones">
              <button class="boton-recorrido" type="button" data-ampliar-actual>Ampliar captura</button>
              <a class="enlace-original" href={escenas[0].captura} data-original-actual>Ver captura original</a>
            </div>
          </div>
        </div>
        <button class="boton-recorrido detener" type="button" data-detener>Ver sin animación</button>
      </div>
    </div>
    <div class="explorador-escenas" data-escenas>
      {escenas.map((escena, indice) => (
        <article id={`escena-${escena.clave}`} class="explorador-escena" aria-labelledby={`titulo-escena-${escena.clave}`} data-escena data-clave={escena.clave}>
          <div class="escena-encabezado">
            <h3 id={`titulo-escena-${escena.clave}`}>{escena.titulo}</h3>
            <p data-descripcion>{escena.descripcion}</p>
            <div class="escena-acciones">
              <button class="boton-recorrido" type="button" data-ampliar hidden>Ampliar captura</button>
              <a class="enlace-original" href={escena.captura} data-original>Ver captura original</a>
            </div>
          </div>
          <figure class="escena-figura">
            <img class="captura-completa" src={escena.captura} alt={escena.alternativa} width="1440" height="1000" loading={indice === 0 ? 'eager' : 'lazy'} decoding="async" data-captura />
            <figcaption>{rotuloCaptura}</figcaption>
          </figure>
        </article>
      ))}
    </div>

    <dialog class="explorador-dialogo" aria-labelledby="titulo-captura-ampliada" data-dialogo>
      <div class="dialogo-encabezado">
        <div>
          <h2 id="titulo-captura-ampliada" data-titulo-ampliado>{escenas[0].titulo}</h2>
          <p>{rotuloCaptura}</p>
        </div>
        <button class="boton-recorrido dialogo-cerrar" type="button" data-cerrar autofocus>Cerrar</button>
      </div>
      <div class="dialogo-lienzo" role="region" aria-label="Captura ampliada. Desplazar para revisar todos los detalles." tabindex="0" data-lienzo-ampliado>
        <img src={escenas[0].captura} alt={escenas[0].alternativa} width="1440" height="1000" loading="lazy" decoding="async" data-captura-ampliada />
      </div>
      <div class="dialogo-pie">
        <button class="boton-recorrido" type="button" aria-pressed="false" data-tamano-real>Ver tamaño real</button>
        <a class="enlace-original" href={escenas[0].captura} data-original-ampliado>Ver captura original</a>
      </div>
    </dialog>
  </div>
</section>
<script src="../scripts/explorador.ts"></script>
<style>
  [hidden] { display: none !important; }
  .explorador { --alto-cabecera: 90px; background: white; overflow-x: clip; }
  .explorador-interior { width: min(100% - 64px, 1200px); margin-inline: auto; scroll-margin-top: 100px; }
  .explorador-recorrido { height: calc((100svh - 110px) * 6); }
  .recorrido-escenario { position: sticky; top: 100px; height: calc(100svh - 110px); min-height: 560px; }
  .escenario-composicion { position: absolute; left: 50%; top: 50%; width: min(76%, 900px, calc((100svh - 240px) * 1.44)); transform: translate(-50%, -50%); z-index: 2; }
  .escenario-marco { position: relative; aspect-ratio: 1440 / 1000; border: 1px solid var(--color-gray-300); border-radius: var(--radius-base); overflow: hidden; background: var(--color-gray-25); }
  .escenario-capa { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; }
  .escenario-capa:first-child { opacity: 1; }
  .escenario-contorno { position: absolute; inset: -16px; width: calc(100% + 32px); height: calc(100% - 50px); z-index: -1; fill: var(--color-brand-50); }
  .escenario-informacion { text-align: center; padding-top: 14px; }
  .captura-rotulo, figcaption { color: var(--color-gray-600); font-size: 12px; margin-top: 12px; }
  .escena-acciones { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 24px; }
  .boton-recorrido, .enlace-original { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px; color: var(--color-gray-600); font: inherit; font-size: 13px; cursor: pointer; text-decoration: underline; text-underline-offset: 5px; background: transparent; border: 0; }
  .boton-recorrido:hover, .enlace-original:hover { color: var(--color-brand-700); }
  .detener { position: absolute; bottom: 0; right: 0; z-index: 3; }
  .escenario-timeline { position: absolute; left: 0; top: 50%; width: 26%; transform: translateY(-50%); z-index: 1; }
  .escenario-timeline > p { font-size: 12px; color: var(--color-gray-600); margin-bottom: 26px; }
  .timeline-linea { height: 2px; background: var(--color-gray-200); }
  .timeline-linea span { display: block; height: 100%; background: var(--color-brand-500); transform: scaleX(0); transform-origin: left; }
  .timeline-paso button { display: flex; gap: 16px; align-items: center; width: 100%; min-height: 64px; border: 0; text-align: left; background: none; font: inherit; font-weight: 500; font-size: 22px; cursor: pointer; color: var(--color-gray-600); }
  .timeline-paso button span { font-size: 12px; font-weight: 400; }
  .timeline-paso button[aria-expanded='true'] { color: var(--color-brand-700); }
  .timeline-paso h3 { font-size: 16px; font-weight: 500; line-height: 1.5; margin: 4px 0 12px; }
  .timeline-paso p { font-size: 15px; color: var(--color-gray-600); line-height: 1.7; margin-bottom: 28px; }
  .escenario-adornos { position: absolute; inset: 0; pointer-events: none; }
  .adornos-grupo { position: absolute; inset: 0; }
  .adorno { position: absolute; width: 220px; padding: 24px; border: 1px solid var(--color-brand-100); border-radius: var(--radius-base); background: var(--color-brand-25); color: var(--color-brand-700); }
  .adorno-izquierdo { left: -20px; top: -70px; transform: rotate(-12deg); }
  .adorno-derecho { right: -20px; top: -40px; transform: rotate(10deg); background: var(--color-gray-25); }
  .adorno svg { width: 100%; height: 100px; margin: 20px 0; }
  .adorno span { font-size: 13px; }
  .adorno-numero { display: block; }
  .adorno strong { display: block; margin-top: 20px; font-size: 24px; font-weight: 500; line-height: 1.2; }
  .adornos-grupo:nth-child(2) .adorno { color: #24645c; background: #f1f7f5; border-color: #dbe9e4; }
  .adornos-grupo:nth-child(3) .adorno { color: #85522e; background: #fbf5ef; border-color: #eee0d0; }
  .explorador-escena { padding: 48px 0; scroll-margin-top: 110px; }
  .escena-encabezado { text-align: center; margin-bottom: 24px; }
  .escena-encabezado h3 { font-size: 28px; font-weight: 500; }
  .escena-encabezado p { margin: 16px auto; max-width: 600px; color: var(--color-gray-600); }
  .escena-figura { margin: 0; text-align: center; }
  .captura-completa { display: block; width: 100%; height: auto; border: 1px solid var(--color-gray-200); border-radius: var(--radius-base); }
  .explorador-dialogo {
    width: min(1480px, calc(100% - 48px));
    max-width: none;
    height: min(1100px, calc(100dvh - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-base);
    background: var(--color-white);
    color: var(--color-gray-900);
  }

  .explorador-dialogo[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .explorador-dialogo::backdrop {
    background: rgb(14 18 29 / 0.65);
  }

  .dialogo-encabezado {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .dialogo-encabezado h2 {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
  }

  .dialogo-encabezado p {
    margin-top: 4px;
    color: var(--color-gray-600);
    font-size: 12px;
    line-height: 1.5;
  }

  .dialogo-cerrar {
    flex-shrink: 0;
  }

  .dialogo-lienzo {
    min-width: 0;
    min-height: 0;
    overflow: auto;
    background: var(--color-gray-25);
  }

  .dialogo-lienzo img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dialogo-lienzo.tamano-real img {
    width: 1440px;
    max-width: none;
    height: auto;
  }

  .dialogo-pie {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    padding: 8px 20px;
    border-top: 1px solid var(--color-gray-200);
  }


  @media (max-width: 767px) {
    .explorador-interior { width: calc(100% - 40px); }
    .explorador-dialogo { width: calc(100% - 24px); }
    .dialogo-encabezado { padding: 12px; }
    .dialogo-encabezado h2 { font-size: 16px; }
    .dialogo-pie { padding: 8px; }
  }
</style>
