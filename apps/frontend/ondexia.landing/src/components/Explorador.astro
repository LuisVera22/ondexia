---
const escenas = [
  {
    clave: 'venta',
    numero: '01',
    titulo: 'Preparar la venta',
    tituloCorto: 'Venta',
    descripcion: 'Seleccionar bienes y servicios, identificar al cliente y revisar el importe antes de registrar la operación.',
    alternativa: 'Registro de venta en Ondexia con cliente, líneas de bienes y servicios y resumen de importes.',
    alturaEscritorio: 864,
    alturaMovil: 2081,
  },
  {
    clave: 'registro',
    numero: '02',
    titulo: 'Revisar el registro',
    tituloCorto: 'Registro',
    descripcion: 'Consultar los datos del documento, el detalle de la venta y los pagos registrados en una misma vista.',
    alternativa: 'Registro de una nota de venta en Ondexia con datos del documento, cliente, detalle, pagos e importe total.',
    alturaEscritorio: 901,
    alturaMovil: 1615,
  },
  {
    clave: 'documento',
    numero: '03',
    titulo: 'Previsualizar el documento',
    tituloCorto: 'Documento',
    descripcion: 'Revisar la nota de venta y su detalle en la previsualización del documento.',
    alternativa: 'Previsualización de una nota de venta en Ondexia con emisor, detalle e importe total.',
    alturaEscritorio: 633,
    alturaMovil: 803,
  },
];
---

<section id="explorar" class="explorador" aria-labelledby="titulo-explorador" data-explorador>
  <div class="explorador-interior">
    <div class="explorador-presentacion">
      <h2 id="titulo-explorador">La operación, en pantalla.</h2>
      <p>Del registro de la venta a la consulta de su documento.</p>
    </div>

    <!-- Los enlaces recorren las tres escenas incluso sin ejecutar el script. -->
    <nav class="explorador-navegacion" aria-label="Recorrido del sistema" data-pasos>
      <div class="explorador-pasos">
        {escenas.map((escena) => (
          <a
            class="explorador-paso"
            href={`#escena-${escena.clave}`}
            aria-label={`${escena.numero} ${escena.titulo}`}
            data-paso
          >
            <span class="paso-numero" aria-hidden="true">{escena.numero}</span>
            <span class="titulo-amplio">{escena.titulo}</span>
            <span class="titulo-corto" aria-hidden="true">{escena.tituloCorto}</span>
          </a>
        ))}
      </div>
      <div class="explorador-avance">
        <button class="avance-boton" type="button" aria-label="Escena anterior" data-anterior hidden>
          <span class="titulo-amplio">Escena anterior</span>
          <span class="titulo-corto" aria-hidden="true">Anterior</span>
          <span class="avance-icono" aria-hidden="true">←</span>
        </button>
        <span class="avance-progreso" data-progreso>3 escenas</span>
        <button class="avance-boton" type="button" aria-label="Escena siguiente" data-siguiente hidden>
          <span class="titulo-amplio">Escena siguiente</span>
          <span class="titulo-corto" aria-hidden="true">Siguiente</span>
          <span class="avance-icono" aria-hidden="true">→</span>
        </button>
      </div>
    </nav>

    <div class="explorador-escenas">
      {escenas.map((escena, indice) => (
        <article
          id={`escena-${escena.clave}`}
          class="explorador-escena"
          aria-labelledby={`titulo-escena-${escena.clave}`}
          data-escena
        >
          <div class="escena-encabezado">
            <div class="escena-descripcion">
              <h3 id={`titulo-escena-${escena.clave}`}>{escena.titulo}</h3>
              <p>{escena.descripcion}</p>
            </div>
            <div class="escena-acciones">
              <button class="escena-ampliar" type="button" data-ampliar hidden>Ampliar captura</button>
              <a
                class="escena-original escena-original-escritorio"
                href={`/capturas/${escena.clave}-escritorio.png`}
                data-original
                data-original-escritorio={`/capturas/${escena.clave}-escritorio.png`}
                data-original-movil={`/capturas/${escena.clave}-movil.png`}
              >Ver captura original</a>
              <a class="escena-original escena-original-movil" href={`/capturas/${escena.clave}-movil.png`}>Ver captura original</a>
            </div>
          </div>

          <figure class="escena-figura" data-figura>
            <div
              class="escena-captura"
              role="region"
              aria-label={`Captura: ${escena.titulo}`}
              tabindex="0"
              data-plano
            >
              <picture>
                <source
                  media="(max-width: 600px)"
                  srcset={`/capturas/${escena.clave}-movil.png`}
                  width="348"
                  height={escena.alturaMovil}
                />
                <img
                  src={`/capturas/${escena.clave}-escritorio.png`}
                  alt={escena.alternativa}
                  width="1082"
                  height={escena.alturaEscritorio}
                  loading={indice === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  data-captura
                />
              </picture>
            </div>
            <figcaption>Capturas del sistema · datos de demostración<span class="captura-ayuda-movil">Desplazar la captura para ver el resto.</span></figcaption>
          </figure>
        </article>
      ))}
    </div>

    <dialog class="explorador-dialogo" aria-labelledby="titulo-captura-ampliada" data-dialogo>
      <div class="dialogo-encabezado">
        <div>
          <h2 id="titulo-captura-ampliada" data-titulo-ampliado>Preparar la venta</h2>
          <p>Capturas del sistema · datos de demostración</p>
        </div>
        <button class="dialogo-cerrar" type="button" data-cerrar autofocus>Cerrar</button>
      </div>
      <div class="dialogo-captura">
        <picture>
          <source media="(max-width: 600px)" srcset="/capturas/venta-movil.png" width="348" height={escenas[0].alturaMovil} data-fuente-ampliada />
          <img
            src="/capturas/venta-escritorio.png"
            alt={escenas[0].alternativa}
            width="1082"
            height={escenas[0].alturaEscritorio}
            loading="lazy"
            decoding="async"
            data-captura-ampliada
          />
        </picture>
      </div>
      <div class="dialogo-pie">
        <a href="/capturas/venta-escritorio.png" data-original-ampliado>Ver captura original</a>
      </div>
    </dialog>
  </div>
</section>

<script src="../scripts/explorador.ts"></script>

<style>
  .explorador {
    --alto-cabecera: 90px;
    scroll-margin-top: 100px;
    background: var(--color-white);
  }

  .explorador-interior {
    width: min(100% - 64px, 1200px);
    margin-inline: auto;
    padding-bottom: 88px;
  }

  .explorador-presentacion {
    margin-bottom: 24px;
    text-align: center;
  }

  .explorador-presentacion h2 {
    color: var(--color-gray-900);
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .explorador-presentacion p {
    margin-top: 10px;
    color: var(--color-gray-600);
    font-size: 16px;
    line-height: 1.6;
  }

  .explorador-navegacion {
    position: sticky;
    z-index: 30;
    top: var(--alto-cabecera, 90px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-gray-200);
    background: var(--color-white);
  }

  .explorador-pasos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    flex: 1;
    gap: 4px;
    min-width: min(100%, 520px);
    padding: 4px;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-base);
    background: var(--color-gray-25);
  }

  .avance-boton[hidden],
  .escena-ampliar[hidden] {
    display: none;
  }

  .explorador-paso {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    border-radius: var(--radius-base);
    background: transparent;
    color: var(--color-gray-600);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    transition:
      color var(--duracion-normal) var(--ease-propia),
      background-color var(--duracion-normal) var(--ease-propia),
      border-color var(--duracion-normal) var(--ease-propia);
  }

  .paso-numero {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .explorador-paso:hover {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
  }

  .explorador-paso[aria-current='step'] {
    border-color: var(--color-gray-300);
    border-bottom-color: var(--color-brand-500);
    background: var(--color-white);
    color: var(--color-brand-700);
  }

  .titulo-corto {
    display: none;
  }

  .avance-icono {
    display: none;
  }

  .explorador-avance {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 10px;
    max-width: 100%;
  }

  .avance-progreso {
    color: var(--color-gray-600);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    white-space: nowrap;
  }

  .explorador-escenas {
    display: grid;
  }

  .explorador-escena {
    display: grid;
    grid-template-columns: minmax(0, 0.33fr) minmax(0, 0.67fr);
    align-items: start;
    gap: 48px;
    min-height: 80svh;
    min-width: 0;
    padding-block: 48px;
    border-bottom: 1px solid var(--color-gray-200);
    scroll-margin-top: var(--tope-recorrido, 200px);
  }

  .explorador-escena:last-child {
    border-bottom: 0;
  }

  .escena-encabezado {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .escena-descripcion {
    max-width: 370px;
  }

  .escena-descripcion h3 {
    color: var(--color-gray-900);
    font-size: clamp(26px, 2.7vw, 36px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .escena-descripcion p {
    margin-top: 16px;
    color: var(--color-gray-600);
    font-size: 17px;
    line-height: 1.7;
  }

  .escena-acciones {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .escena-ampliar,
  .avance-boton,
  .dialogo-cerrar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--color-gray-500);
    border-radius: var(--radius-base);
    background: var(--color-white);
    color: var(--color-gray-800);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    transition: background-color var(--duracion-normal) var(--ease-propia);
  }

  .escena-ampliar,
  .escena-original,
  .escena-captura {
    scroll-margin-top: var(--tope-recorrido, 200px);
    scroll-margin-bottom: 24px;
  }

  .escena-ampliar:hover,
  .avance-boton:not(:disabled):hover,
  .dialogo-cerrar:hover {
    background: var(--color-gray-50);
  }

  .avance-boton:disabled {
    border-color: var(--color-gray-300);
    background: var(--color-gray-50);
    color: var(--color-gray-500);
    cursor: default;
  }

  .escena-original,
  .dialogo-pie a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-brand-700);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .escena-original-movil {
    display: none;
  }

  figure {
    margin: 0;
  }

  .escena-figura {
    min-width: 0;
  }

  .escena-figura.figura-fijada {
    position: sticky;
    top: var(--tope-recorrido, 200px);
    align-self: start;
  }

  .escena-captura {
    --desplazamiento-captura: 0px;
    overflow: hidden;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-base);
    background: var(--color-gray-25);
  }

  picture,
  img {
    display: block;
  }

  img {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 12px;
    color: var(--color-gray-600);
    font-size: 12px;
    line-height: 1.5;
    text-align: right;
  }

  .captura-ayuda-movil {
    display: none;
  }

  .explorador-dialogo {
    width: min(1480px, calc(100% - 48px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-base);
    background: var(--color-white);
    color: var(--color-gray-900);
  }

  .explorador-dialogo::backdrop {
    background: rgb(14 18 29 / 0.65);
  }

  .dialogo-encabezado {
    position: sticky;
    z-index: 1;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-gray-200);
    background: var(--color-white);
  }

  .dialogo-encabezado h2 {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
  }

  .dialogo-encabezado p {
    margin-top: 5px;
    color: var(--color-gray-600);
    font-size: 12px;
    line-height: 1.5;
  }

  .dialogo-cerrar {
    flex-shrink: 0;
  }

  .dialogo-captura {
    overflow: auto;
    background: var(--color-gray-25);
  }

  .dialogo-pie {
    position: sticky;
    bottom: 0;
    padding: 8px 24px;
    border-top: 1px solid var(--color-gray-200);
    background: var(--color-white);
  }

  @media (max-width: 1023px) {
    .explorador {
      --alto-cabecera: 76px;
    }
    .explorador-navegacion {
      top: var(--alto-cabecera, 76px);
      flex-direction: column;
      gap: 8px;
      padding-block: 10px;
    }

    .explorador-pasos {
      width: 100%;
      flex: none;
    }

    .explorador-escena {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      min-height: 0;
      padding-block: 36px;
    }

    .escena-descripcion {
      max-width: 640px;
    }

    .escena-descripcion h3 {
      font-size: 28px;
    }

    .escena-descripcion p {
      margin-top: 12px;
    }

    .escena-encabezado {
      gap: 16px;
    }

    .escena-acciones {
      flex-direction: row;
      align-items: center;
      gap: 16px;
    }

    .escena-figura.figura-fijada {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .explorador-interior {
      width: calc(100% - 40px);
      padding-bottom: 60px;
    }

    .explorador-paso {
      gap: 0;
      padding: 8px 6px;
      font-size: 13px;
    }

    .paso-numero,
    .titulo-amplio {
      display: none;
    }

    .titulo-corto {
      display: inline;
    }

    .explorador-avance {
      gap: 12px;
    }

    .avance-boton {
      padding: 8px 12px;
      font-size: 13px;
    }

    .escena-descripcion h3 {
      font-size: 26px;
    }

    .escena-descripcion p {
      font-size: 15px;
    }

    figcaption {
      text-align: left;
    }

    .explorador-dialogo {
      width: calc(100% - 24px);
      max-height: calc(100dvh - 24px);
    }

    .dialogo-encabezado {
      gap: 12px;
      padding: 16px;
    }

    .dialogo-encabezado h2 {
      font-size: 17px;
    }

    .dialogo-pie {
      padding-inline: 16px;
    }
  }

  @media (max-width: 360px) {
    .escena-acciones {
      flex-wrap: wrap;
      gap: 4px 16px;
    }
  }

  @media (max-height: 799px) {
    .escena-figura.figura-fijada {
      position: static;
    }
  }

  /* Una ventana baja necesita conservar espacio para el título y el contenido. */
  @media (max-height: 599px) {
    .explorador-navegacion {
      flex-direction: row;
      gap: 8px;
      padding-block: 4px;
    }

    .explorador-pasos {
      flex: none;
      width: auto;
      min-width: 0;
      padding: 0;
      grid-template-columns: repeat(3, 44px);
    }

    .explorador-paso {
      padding: 8px 4px;
    }

    .titulo-amplio,
    .titulo-corto {
      display: none;
    }

    .paso-numero,
    .avance-icono {
      display: inline;
    }

    .explorador-avance {
      width: auto;
      gap: 4px;
    }

    .avance-boton {
      width: 44px;
      padding: 8px;
    }

    .avance-progreso {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .explorador-escena {
      min-height: 0;
      padding-block: 12px;
      scroll-margin-top: var(--tope-recorrido, calc(var(--alto-cabecera, 90px) + 66px));
    }

    .escena-descripcion h3 {
      font-size: 26px;
    }
  }

  @media (max-width: 600px) {
    .captura-ayuda-movil {
      display: block;
      margin-top: 4px;
    }
    .escena-original-escritorio {
      display: none;
    }

    .escena-original-movil {
      display: inline-flex;
    }

    .escena-captura {
      max-height: 620px;
      overflow-y: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .escena-captura {
      transform: translate3d(0, var(--desplazamiento-captura, 0px), 0);
    }

    .explorador-escena.escena-actual .escena-figura {
      animation: entrada-escena var(--duracion-normal) var(--ease-propia);
    }

    @keyframes entrada-escena {
      from { transform: translateY(6px); }
      to { transform: translateY(0); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .explorador-paso,
    .avance-boton,
    .escena-ampliar,
    .dialogo-cerrar {
      transition: none;
    }

    .escena-captura {
      --desplazamiento-captura: 0px;
      transform: none;
    }

    .escena-figura.figura-fijada {
      position: static;
      top: auto;
    }
  }
</style>
