---
interface Props { indice: number; }
const { indice } = Astro.props;
---
<div class="objetos" data-tema={indice}>
  <div class="pieza pieza-documento">
    <span class="documento-cabecera">ONDEXIA <span>0{indice + 1}</span></span>
    <strong>{['Preparar la venta', 'Detalle de la operación', 'Nota de venta'][indice]}</strong>
    <svg viewBox="0 0 180 130" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false">
      {indice === 0 ? <><path d="m45 32 45-22 45 22-45 22Z M45 32v58l45 24 45-24V32 M90 54v60 M68 20l45 23v27"/><circle cx="148" cy="97" r="17" fill="white"/><path d="M140 97h16 M148 89v16"/></>
        : indice === 1 ? <><path d="M24 20h132v90H24Z M24 46h132 M65 20v90 M24 68h132 M24 89h132"/><circle cx="126" cy="91" r="24" fill="white"/><path d="m143 108 18 18 M115 91h22 M126 80v22"/></>
        : <><path d="M47 8h66l20 20v94H47Z M113 8v22h20 M60 51h60 M60 65h60 M60 79h38 M60 101h20 M100 101h20"/><path d="m47 122 6-5 6 5 6-5 6 5 6-5 6 5 6-5 6 5 6-5 6 5 6-5 6 5 6-5 8 5"/></>}
    </svg>
    <div class="renglones"><i></i><i></i><i></i></div>
    <span class="documento-pie">{['Bienes · servicios', 'Cliente · detalle · pagos', 'Vista previa · impresión'][indice]}</span>
  </div>
  <svg class="pieza pieza-flor" viewBox="0 0 120 120" fill="currentColor" focusable="false">
    <path d="M60 8C82-9 94 17 88 32C114 22 132 52 108 66C130 88 100 114 82 98C82 128 46 130 42 102C20 124-6 94 12 76C-12 61 8 27 30 38C20 12 48-6 60 8Z"/>
    <circle cx="60" cy="63" r="15" fill="white"/>
  </svg>
  <div class="pieza pieza-etiqueta"><svg class="etiqueta-marca" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M6 18 18 6 M6 6h12v12"/></svg><span>{['Una operación', 'Todo a la vista', 'Listo para revisar'][indice]}</span></div>
  <svg class="pieza pieza-orbita" viewBox="0 0 180 180" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
    <circle cx="90" cy="90" r="74"/><ellipse cx="90" cy="90" rx="31" ry="74"/><ellipse cx="90" cy="90" rx="74" ry="27"/><path d="M16 90h148 M90 16v148"/>
  </svg>
  <svg class="pieza pieza-trazo" viewBox="0 0 240 140" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" focusable="false">
    <path d="M8 123C82-16 105 14 60 94S120 148 155 49S139 109 225 15"/>
  </svg>
  <svg class="pieza pieza-destello" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" focusable="false">
    <path d="M50 8v84 M13 29l74 42 M13 71l74-42"/>
  </svg>
  <div class="pieza pieza-formatos"><span>{['Seleccionar', 'Consultar', 'A4'][indice]}</span><span>{['Revisar', 'Revisar', 'Ticket 80 mm'][indice]}</span></div>
</div>
<style>
  .objetos { --tinta: #4f46e5; --papel: #f0efff; position: absolute; inset: 0; color: var(--tinta); }
  [data-tema='1'] { --tinta: #24645c; --papel: #edf6f2; }
  [data-tema='2'] { --tinta: #85522e; --papel: #fbf0e5; }
  .pieza { position: absolute; }
  .pieza-documento { left: -4%; top: 4%; width: 215px; padding: 22px; background: var(--papel); border: 1px solid currentColor; border-radius: var(--radius-base); transform: rotate(-13deg); }
  .documento-cabecera { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .08em; }
  strong { display: block; font-size: 21px; line-height: 1.2; font-weight: 500; margin-top: 20px; }
  .pieza-documento svg { width: 100%; margin-block: 14px; }
  .renglones { display: grid; gap: 8px; opacity: .25; }
  .renglones i { height: 2px; background: currentColor; }
  .renglones i:last-child { width: 65%; }
  .documento-pie { display: block; margin-top: 20px; font-size: 11px; }
  .pieza-flor { width: 100px; left: 6%; top: 65%; transform: rotate(18deg); }
  .pieza-etiqueta { right: -3%; top: 8%; padding: 16px 20px; display: flex; align-items: center; gap: 12px; font-size: 18px; background: var(--papel); border-radius: var(--radius-base); transform: rotate(9deg); }
  .etiqueta-marca { font: 32px system-ui, sans-serif; }
  .pieza-orbita { width: 155px; right: -4%; top: 38%; transform: rotate(-18deg); }
  .pieza-trazo { width: 185px; right: 0; top: 69%; transform: rotate(-8deg); }
  .pieza-destello { width: 65px; left: 18%; top: -6%; color: var(--color-gray-900); transform: rotate(12deg); }
  .pieza-formatos { display: flex; gap: 8px; left: 10%; top: 88%; transform: rotate(-8deg); }
  .pieza-formatos span { padding: 9px 14px; font-size: 12px; border: 1px solid currentColor; border-radius: var(--radius-base); background: white; }
  @media (max-width: 1199px) { .pieza-documento { left: -7%; width: 180px; } .pieza-etiqueta { right: -5%; font-size: 15px; } .pieza-orbita { width: 125px; } }
  @media (max-width: 1023px) { .pieza-documento, .pieza-orbita, .pieza-formatos { display: none; } .pieza-flor { width: 48px; top: 0; left: -10px; } .pieza-etiqueta { top: -20px; right: 10px; font-size: 12px; padding: 6px 10px; } .etiqueta-marca { font-size: 18px; } .pieza-destello { width: 32px; left: 25%; top: -28px; } .pieza-trazo { width: 65px; top: 25%; right: -14px; } }
</style>
