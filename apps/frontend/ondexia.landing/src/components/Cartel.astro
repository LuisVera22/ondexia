---
import VistaProducto from './VistaProducto.astro';
---

<section class="portada" aria-labelledby="titulo-portada">
  <div class="portada-interior">
    <div class="portada-contenido">
      <p class="portada-rotulo">Gestión comercial · Perú</p>

      <h1 id="titulo-portada">
        <span>Ventas, caja y almacén.</span>
        <span class="portada-acento">Una operación conectada.</span>
      </h1>

      <p class="portada-descripcion">
        Registrar bienes y servicios, emitir documentos de venta y mantener
        los cobros y las existencias dentro del mismo flujo.
      </p>

      <div class="portada-acciones">
        <a href="#acceso" class="btn-primario">Solicitar acceso</a>
        <a href="#funciones" class="btn-contorno">Conocer el sistema</a>
      </div>

      <p class="portada-contexto">Diseñado para el trabajo diario de mostrador.</p>
    </div>

    <div class="portada-producto">
      <VistaProducto />
    </div>
  </div>
</section>

<style>
  .portada {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .portada-interior {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 56px;
    max-width: 1240px;
    margin-inline: auto;
    padding: 96px 40px 104px;
  }

  .portada-contenido,
  .portada-producto {
    min-width: 0;
  }

  .portada-rotulo {
    margin-bottom: 24px;
    color: var(--color-gray-600);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1 {
    max-width: 550px;
    color: var(--color-gray-900);
    font-size: clamp(44px, 4.65vw, 62px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }

  h1 > span {
    display: block;
  }

  .portada-acento {
    color: var(--color-brand-700);
  }

  .portada-descripcion {
    max-width: 460px;
    margin-top: 28px;
    color: var(--color-gray-600);
    font-size: 18px;
    line-height: 1.65;
  }

  .portada-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }

  .portada-contexto {
    max-width: 440px;
    margin-top: 22px;
    color: var(--color-gray-600);
    font-size: 13px;
    line-height: 1.6;
  }

  @media (max-width: 1050px) {
    .portada-interior {
      gap: 32px;
      padding-block: 72px 80px;
    }

    h1 {
      font-size: 46px;
    }
  }

  @media (max-width: 850px) {
    .portada-interior {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-block: 64px 72px;
    }

    .portada-contenido {
      max-width: 650px;
    }

    h1 {
      max-width: 650px;
      font-size: clamp(40px, 6.6vw, 58px);
    }

    .portada-producto {
      width: 100%;
      max-width: 660px;
    }
  }

  @media (max-width: 500px) {
    .portada-interior {
      gap: 36px;
      padding: 44px 20px 48px;
    }

    .portada-rotulo {
      margin-bottom: 20px;
      font-size: 11px;
    }

    h1 {
      font-size: clamp(35px, 9.2vw, 44px);
      letter-spacing: -0.04em;
      line-height: 1.12;
    }

    .portada-descripcion {
      margin-top: 24px;
      font-size: 16px;
      line-height: 1.65;
    }

    .portada-acciones {
      flex-direction: column;
      align-items: stretch;
      margin-top: 28px;
    }

    .portada-acciones a {
      width: 100%;
    }

    .portada-contexto {
      font-size: 12px;
    }
  }
</style>
