---
// Se conserva el destino vigente; un formulario sin destino no se presenta como operativo.
const endpoint = import.meta.env.PUBLIC_ENDPOINT_LISTA ?? '';
const correo = 'hola@ondexia.com';
---

<section id="acceso" class="seccion contacto" aria-labelledby="titulo-contacto">
  <div class="contenedor contacto-interior">
    <div>
      <p class="rotulo text-brand-600">El siguiente paso</p>
      <h2 id="titulo-contacto" class="titulo-seccion">Conocer Ondexia en acción.</h2>
      <p class="descripcion-contacto">Solicitar acceso para conocer el sistema. Si ya se dispone de una cuenta, ingresar a la aplicación.</p>
    </div>
    <div class="acciones-contacto">
      {endpoint ? (
        <form action={endpoint} method="POST">
          <div hidden aria-hidden="true">
            <label for="sitio_web">No rellenar</label>
            <input id="sitio_web" type="text" name="sitio_web" tabindex="-1" autocomplete="off" />
          </div>
          <label for="correo">Correo de contacto</label>
          <input id="correo" type="email" name="correo" required autocomplete="email" placeholder="correo@empresa.com" />
          <label class="consentimiento">
            <input type="checkbox" name="consentimiento" value="si" required />
            <span>Se acepta que Ondexia use este correo solo para avisar del acceso. La baja se solicita escribiendo a <a href={`mailto:${correo}`}>{correo}</a>.</span>
          </label>
          <button type="submit" class="btn-primario">Solicitar acceso</button>
        </form>
      ) : (
        <a href={`mailto:${correo}?subject=Informaci%C3%B3n%20sobre%20Ondexia`} class="btn-primario">Solicitar acceso</a>
      )}
      <a href="https://app.ondexia.com" class="enlace-aplicacion">Ingresar a la aplicación <svg class="flecha" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M6 18 18 6M6 6h12v12" /></svg></a>
      <p>También se puede escribir directamente a<br /><a href={`mailto:${correo}`}>{correo}</a></p>
    </div>
  </div>
</section>

<style>
  .contacto { background: white; }
  .enlace-aplicacion { display: flex; align-items: center; min-height: 44px; margin-top: 12px; font-size: 14px; text-decoration: underline; text-underline-offset: 4px; }
  .contacto-interior { padding: 48px; background: var(--color-gray-25); border-radius: var(--radius-base); display: grid; grid-template-columns: 1fr 0.65fr; gap: 90px; align-items: center; }
  .descripcion-contacto { margin-top: 24px; max-width: 430px; font-size: 17px; line-height: 1.7; color: var(--color-gray-600); }
  .acciones-contacto > .btn-primario { min-width: 240px; }
  .acciones-contacto > p { margin-top: 22px; color: var(--color-gray-600); font-size: 14px; line-height: 1.8; }
  .acciones-contacto > p a { color: var(--color-gray-900); text-decoration: underline; text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 44px; }
  form { display: grid; gap: 13px; }
  form > label { font-size: 15px; }
  input[type='email'] { width: 100%; min-height: 48px; padding: 12px 15px; border: 1px solid var(--color-gray-300); border-radius: var(--radius-base); background: white; font-size: 16px; }
  input::placeholder { color: var(--color-gray-600); }
  .consentimiento { display: flex; align-items: flex-start; gap: 12px; font-size: 13px; color: var(--color-gray-600); line-height: 1.7; }
  .consentimiento input { width: 18px; height: 18px; margin-top: 3px; flex-shrink: 0; accent-color: var(--color-brand-500); }
  .consentimiento a { text-decoration: underline; }
  @media (max-width: 767px) { .contacto-interior { grid-template-columns: 1fr; gap: 32px; padding: 32px 24px; } .acciones-contacto > .btn-primario { width: 100%; min-width: 0; } }
</style>
