---
import Logo from './Logo.astro';
const razonSocial = import.meta.env.PUBLIC_TITULAR_RAZON_SOCIAL;
const ruc = import.meta.env.PUBLIC_TITULAR_RUC;
const direccion = import.meta.env.PUBLIC_TITULAR_DIRECCION;
---

<footer>
  <div class="contenedor pie-superior">
    <div class="identidad">
      <Logo ancho={152} />
      <p>Gestión comercial<br />para empresas peruanas.</p>
      {razonSocial && <p>{razonSocial}{ruc && <> · RUC {ruc}</>}{direccion && <><br />{direccion}</>}</p>}
    </div>
    <nav aria-label="Pie de página">
      <div>
        <h2>Ondexia</h2>
        <a href="/#funciones">El sistema</a>
        <a href="/planes.html">Planes</a>
        <a href="/#preguntas">Preguntas frecuentes</a>
      </div>
      <div>
        <h2>Contacto</h2>
        <a href="/#acceso">Solicitar información</a>
        <a href="https://app.ondexia.com">Ingresar al sistema</a>
        <a href="mailto:hola@ondexia.com">hola@ondexia.com</a>
      </div>
    </nav>
  </div>
  <div class="contenedor pie-inferior">
    <p>© {new Date().getFullYear()} Ondexia</p>
    <p>Información legal, privacidad y Libro de Reclamaciones: pendientes de publicación.</p>
  </div>
</footer>

<style>
  footer { padding: 54px 0 28px; }
  .pie-superior { display: flex; justify-content: space-between; gap: 60px; }
  .identidad p { margin-top: 18px; font-size: 14px; line-height: 1.7; color: var(--color-gray-600); }
  nav { display: flex; gap: 90px; }
  nav > div { display: flex; flex-direction: column; }
  h2 { margin-bottom: 12px; font-size: 14px; font-weight: 500; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; color: var(--color-gray-600); }
  nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .pie-inferior { display: flex; justify-content: space-between; gap: 26px; margin-top: 38px; padding-top: 23px; border-top: 1px solid var(--color-gray-200); }
  .pie-inferior p { color: var(--color-gray-600); font-size: 12px; line-height: 1.7; }
  @media (max-width: 767px) { .pie-superior, .pie-inferior { flex-direction: column; gap: 30px; } nav { gap: 40px; flex-wrap: wrap; } }
</style>
