---
import Logo from './Logo.astro';

const enlaces = [
  { texto: 'Explorar', destino: '/#explorar' },
  { texto: 'Planes', destino: '/planes.html' },
  { texto: 'Preguntas frecuentes', destino: '/#preguntas' },
];
---

<header>
  <nav class="contenedor navegacion" aria-label="Principal">
    <a href="/" class="inicio" aria-label="Ondexia — inicio"><Logo ancho={152} /></a>
    <div class="enlaces-escritorio">
      {enlaces.map((enlace) => <a href={enlace.destino} class="enlace-subrayado">{enlace.texto}</a>)}
    </div>
    <div class="acciones-escritorio">
      <a href="https://app.ondexia.com" class="ingresar">Ingresar</a>
      <a href="/#acceso" class="btn-primario">Solicitar acceso</a>
    </div>
    <details class="menu-movil">
      <summary>Menú</summary>
      <div class="enlaces-movil">
        {enlaces.map((enlace) => <a href={enlace.destino}>{enlace.texto}</a>)}
        <a href="https://app.ondexia.com">Ingresar al sistema</a>
        <a href="/#acceso" class="btn-primario">Solicitar acceso</a>
      </div>
    </details>
  </nav>
</header>

<style>
  header { border-bottom: 1px solid var(--color-gray-200); position: sticky; top: 0; z-index: 40; background: white; }
  .navegacion { min-height: 90px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
  .inicio { display: flex; align-items: center; min-height: 44px; flex-shrink: 0; }
  .enlaces-escritorio { display: flex; align-items: center; gap: 28px; }
  .enlaces-escritorio a, .ingresar { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 500; color: var(--color-gray-700); }
  .acciones-escritorio { display: flex; align-items: center; gap: 23px; }
  .acciones-escritorio .btn-primario { height: 44px; font-size: 14px; padding-inline: 20px; }
  .menu-movil { display: none; }
  @media (max-width: 1023px) {
    .navegacion { min-height: 76px; }
    .enlaces-escritorio, .acciones-escritorio { display: none; }
    .menu-movil { display: block; }
    summary { display: flex; align-items: center; gap: 16px; min-height: 44px; padding: 0 10px; font-size: 14px; font-weight: 500; list-style: none; cursor: pointer; }
    summary::-webkit-details-marker { display: none; }
    .enlaces-movil { position: absolute; z-index: 30; inset: 76px 0 auto; display: grid; gap: 4px; padding: 12px 20px 22px; background: white; border-bottom: 1px solid var(--color-gray-300); }
    .enlaces-movil a { display: flex; align-items: center; min-height: 48px; font-size: 15px; }
    .enlaces-movil .btn-primario { justify-content: center; margin-top: 8px; }
  }
</style>
