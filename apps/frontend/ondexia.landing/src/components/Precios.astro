---
import { planes } from '../datos/planes';
---

<section id="precios" class="seccion planes" aria-labelledby="titulo-planes">
  <div class="contenedor">
    <div class="encabezado-seccion">
      <div>
        <p class="rotulo text-brand-600">Propuesta de planes</p>
        <h2 id="titulo-planes" class="titulo-seccion">Una opción para cada<br />tamaño de operación.</h2>
      </div>
      <p class="introduccion-seccion">Comparar empresas y usuarios. Consultar las condiciones y el alcance antes de solicitar el acceso.</p>
    </div>
    <div class="lista-planes">
      {planes.map((plan) => (
        <article>
          <h3>{plan.nombre}</h3>
          <p class="precio">{plan.desde && <span>Desde </span>}S/ {plan.precio}<span> / mes</span></p>
          <p class="limites">{plan.descripcion}</p>
          <a href="#acceso" class="enlace-plan">Consultar el plan<span class="sr-only"> {plan.nombre}</span></a>
        </article>
      ))}
    </div>
    <p class="condiciones">Importes en soles, sin IGV. Propuesta comercial pendiente de validación; las condiciones se confirman al solicitar información.</p>
  </div>
</section>

<style>
  .lista-planes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--color-gray-300); }
  article { padding: 32px; border-left: 1px solid var(--color-gray-200); }
  article:first-child { border-left: 0; padding-left: 0; }
  h3 { font-size: 18px; font-weight: 500; margin-bottom: 24px; }
  .precio { font-size: 37px; line-height: 1.3; letter-spacing: -0.03em; font-weight: 500; font-variant-numeric: tabular-nums; }
  .precio span { font-size: 13px; font-weight: 400; letter-spacing: 0; color: var(--color-gray-600); }
  .limites { margin: 16px 0 24px; color: var(--color-gray-600); font-size: 15px; line-height: 1.6; }
  .enlace-plan { display: inline-flex; align-items: center; gap: 26px; min-height: 44px; border-bottom: 1px solid var(--color-brand-200); color: var(--color-brand-700); font-size: 14px; font-weight: 500; }
  .condiciones { margin-top: 20px; color: var(--color-gray-600); font-size: 13px; line-height: 1.6; }
  @media (max-width: 767px) { .lista-planes { grid-template-columns: 1fr; } article, article:first-child { padding: 26px 0; border-left: 0; border-bottom: 1px solid var(--color-gray-200); } article:last-child { border-bottom: 0; } h3 { margin-bottom: 15px; } }
</style>
