---
const aspectos = [
  { titulo: 'Trabajo diario', detalle: 'Ventas, caja, clientes y catálogo son el centro de la versión actual.' },
  { titulo: 'Emisión tributaria en ensayo', detalle: 'Pendiente de validación real ante SUNAT. La nota de venta es un documento interno y no se envía a SUNAT.' },
  { titulo: 'Evolución del producto', detalle: 'Compras y guías de remisión corresponden a las siguientes etapas de desarrollo.' },
];
---

<section id="estado" class="seccion alcance" aria-labelledby="titulo-alcance">
  <div class="contenedor">
    <div class="encabezado-seccion">
      <div>
        <p class="rotulo text-brand-600">Alcance del producto</p>
        <h2 id="titulo-alcance" class="titulo-seccion">Claridad desde el comienzo.</h2>
      </div>
      <p class="introduccion-seccion">Conocer qué cubre el sistema es parte de elegirlo. El alcance se distingue de las próximas etapas.</p>
    </div>
    <dl>
      {aspectos.map((aspecto) => (
        <div><dt>{aspecto.titulo}</dt><dd>{aspecto.detalle}</dd></div>
      ))}
    </dl>
  </div>
</section>

<style>
  .alcance { background: var(--color-brand-25); border-block: 1px solid var(--color-gray-200); }
  dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 42px; }
  dl > div { padding-top: 24px; border-top: 1px solid var(--color-brand-200); }
  dt { margin-bottom: 10px; font-weight: 500; font-size: 18px; }
  dd { font-size: 15px; line-height: 1.7; color: var(--color-gray-600); }
  @media (max-width: 767px) { dl { grid-template-columns: 1fr; gap: 26px; } }
</style>
