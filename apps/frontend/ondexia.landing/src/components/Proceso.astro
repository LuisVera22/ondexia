---
const pasos = [
  { numero: '01', titulo: 'Preparar la venta', detalle: 'Seleccionar bienes o servicios, elegir el documento e identificar al cliente cuando corresponda.' },
  { numero: '02', titulo: 'Registrar el cobro', detalle: 'Indicar los importes y las formas de pago para completar la operación en la caja abierta.' },
  { numero: '03', titulo: 'Consultar lo emitido', detalle: 'Revisar el registro de la venta y abrir la previsualización del documento en A4 o ticket.' },
];
---

<section class="seccion proceso" aria-labelledby="titulo-proceso">
  <div class="contenedor recorrido">
    <div class="presentacion-proceso">
      <p class="rotulo text-brand-200">La operación diaria</p>
      <h2 id="titulo-proceso">La venta se registra.<br />La información queda.</h2>
      <p>Consultar el cliente, el detalle y los pagos de una venta. Revisar lo ocurrido y acceder al documento cuando haga falta.</p>
      <a href="#acceso" class="enlace-proceso">Conocer Ondexia</a>
    </div>
    <ol>
      {pasos.map((paso) => (
        <li>
          <span class="numero" aria-hidden="true">{paso.numero}</span>
          <div><h3>{paso.titulo}</h3><p>{paso.detalle}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proceso { background: var(--color-gray-900); color: white; }
  .recorrido { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  h2 { margin: 22px 0; font-size: clamp(32px, 3.5vw, 46px); line-height: 1.16; letter-spacing: -0.035em; font-weight: 500; }
  .presentacion-proceso > p:not(.rotulo) { max-width: 380px; color: var(--color-gray-300); font-size: 17px; line-height: 1.7; }
  .enlace-proceso { display: inline-flex; align-items: center; gap: 32px; min-height: 44px; margin-top: 30px; border-bottom: 1px solid var(--color-gray-500); font-size: 15px; }
  .proceso :focus-visible { outline-color: var(--color-brand-300); }
  ol { display: grid; }
  li { display: grid; grid-template-columns: 34px 1fr; gap: 22px; padding: 26px 0; border-top: 1px solid var(--color-gray-700); }
  li:first-child { padding-top: 0; border-top: 0; }
  .numero { color: var(--color-brand-200); font-size: 14px; padding-top: 3px; }
  h3 { margin-bottom: 9px; font-size: 21px; line-height: 1.4; font-weight: 500; }
  li p { color: var(--color-gray-300); font-size: 15px; line-height: 1.7; }
  @media (max-width: 767px) { .recorrido { grid-template-columns: 1fr; gap: 42px; } li { padding: 23px 0; } }
</style>
