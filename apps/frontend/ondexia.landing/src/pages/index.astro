---
import Base from '../layouts/Base.astro';
import Barra from '../components/Barra.astro';
import Explorador from '../components/Explorador.astro';
import Modulos from '../components/Modulos.astro';
import Confianza from '../components/Confianza.astro';
import Preguntas from '../components/Preguntas.astro';
import AccesoPlanes from '../components/AccesoPlanes.astro';
import Estado from '../components/Estado.astro';
import Cierre from '../components/Cierre.astro';
import Pie from '../components/Pie.astro';

/**
 * El título es lo que decide el clic desde el buscador: la marca primero, el
 * término después, por debajo de 60 caracteres visibles para que no lo corte.
 * La descripción no posiciona pero sí convierte, y por eso termina en la oferta.
 */
const titulo = 'Ondexia · Ventas, caja y almacén para empresas peruanas';
const descripcion =
  'Gestión comercial para empresas peruanas: ventas, clientes, caja, bienes, servicios y existencias en un mismo sistema. Conocer el alcance de Ondexia.';
---

<Base titulo={titulo} descripcion={descripcion}>
  <Barra />
  <main id="contenido">
    <Explorador />
    <Modulos />
    <AccesoPlanes />
    <Confianza />
    <Estado />
    <Preguntas />
    <Cierre />
  </main>
  <Pie />
</Base>

<script src="../scripts/movimiento.ts"></script>
