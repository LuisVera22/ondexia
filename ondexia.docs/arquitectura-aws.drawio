        </mxCell>

        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="lambda-sunat" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="No hay autorizador Lambda.&#10;API Gateway valida el JWT de Cognito de forma nativa: es&#10;configuración, no código. Un autorizador propio añadiría un&#10;arranque en frío a cada petición y algo más que mantener.&#10;(DTE §7 — DT de identidad)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="El token porta identidad, nada más.&#10;La empresa activa y los permisos por submódulo se resuelven&#10;en la base en cada petición: un JWT es válido hasta que caduca,&#10;y revocar «anular comprobante» no puede esperar. (§8.1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="600" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="Egreso por IP fija.&#10;SUNAT exige un origen estable. Instancia NAT en lugar de NAT&#10;Gateway: mismo efecto por una fracción del coste al volumen&#10;previsto, a cambio de no ser gestionada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#7A2E0E;fillColor=#FFFAEB;strokeColor=#FEDF89;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="700" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="El envío a SUNAT no bloquea al usuario.&#10;Emitir encola; el resultado llega después. El Resumen Diario es&#10;asíncrono por diseño: devuelve un ticket, no un CDR, y hay que&#10;consultarlo aparte. (R-06)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="Única superficie anónima del sistema.&#10;Distribución, WAF y bucket propios. No consulta la base&#10;transaccional: lee una proyección con solo lo publicable, así&#10;que un fallo de autorización no expondría nada más. (R-03)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="545" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="Falta por decidir — DT-12&#10;Si la emisión ante SUNAT se hace propia (este diagrama) o a&#10;través de un proveedor. Con proveedor desaparecen la instancia&#10;NAT, Secrets Manager y la firma XAdES, y aparece un coste por&#10;comprobante." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#912018;fillColor=#FEF3F2;strokeColor=#FECDCA;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="600" width="140" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Pendiente: back-office en app aparte (admin.ondexia.com)&#10;con grupo de usuarios de Cognito separado del de los inquilinos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#475467;fillColor=#F9FAFB;strokeColor=#D0D5DD;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s3-cpe" value="S3&#10;XML firmado + CDR&#10;inmutable" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.bucket;" vertex="1" parent="1">
          <mxGeometry x="1092" y="120" width="46" height="48" as="geometry" />
        </mxCell>

        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lambda-sunat" target="s3-cpe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1115" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e21l" value="conserva" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="e21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="Lo único que hay que guardar como archivo.&#10;El PDF se genera al pedirlo, desde los datos. El XML firmado no: la firma XAdES cubre bytes exactos, y&#10;volver a serializar los mismos datos cambia el orden de atributos o los prefijos de espacios de nombres,&#10;la firma deja de validar y ya no tienes el documento que SUNAT aceptó. El CDR es de un tercero y menos&#10;aún se reconstruye. Ambos son inmutables y con retención larga — verificar el plazo vigente." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="800" width="620" height="85" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
