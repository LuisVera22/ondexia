        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="lambda-sunat" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="No hay autorizador Lambda.&#xa;API Gateway valida el JWT de Cognito de forma nativa: es&#xa;configuración, no código. Un autorizador propio añadiría un&#xa;arranque en frío a cada petición y algo más que mantener.&#xa;(DTE §7 — DT de identidad)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="El token porta identidad, nada más.&#xa;La empresa activa y los permisos por submódulo se resuelven&#xa;en la base en cada petición: un JWT es válido hasta que caduca,&#xa;y revocar «anular comprobante» no puede esperar. (§8.1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="600" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Egreso por IP fija.&#xa;SUNAT exige un origen estable. Instancia NAT en lugar de NAT&#xa;Gateway: mismo efecto por una fracción del coste al volumen&#xa;previsto, a cambio de no ser gestionada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#7A2E0E;fillColor=#FFFAEB;strokeColor=#FEDF89;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="700" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="El envío a SUNAT no bloquea al usuario.&#xa;Emitir encola; el resultado llega después. El Resumen Diario es&#xa;asíncrono por diseño: devuelve un ticket, no un CDR, y hay que&#xa;consultarlo aparte. (R-06)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Única superficie anónima del sistema.&#xa;Distribución, WAF y bucket propios. No consulta la base&#xa;transaccional: lee una proyección con solo lo publicable, así&#xa;que un fallo de autorización no expondría nada más. (R-03)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#026AA2;fillColor=#F0F9FF;strokeColor=#B9E6FE;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="545" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Falta por decidir — DT-12&#xa;Si la emisión ante SUNAT se hace propia (este diagrama) o a&#xa;través de un proveedor. Con proveedor desaparecen la instancia&#xa;NAT, Secrets Manager y la firma XAdES, y aparece un coste por&#xa;comprobante." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#912018;fillColor=#FEF3F2;strokeColor=#FECDCA;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="600" width="140" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Pendiente: back-office en app aparte (admin.ondexia.com)&#xa;con grupo de usuarios de Cognito separado del de los inquilinos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#475467;fillColor=#F9FAFB;strokeColor=#D0D5DD;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="330" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
