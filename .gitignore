# === Secretos y material criptográfico — NUNCA al repositorio ===
# Un certificado que entra al historial obliga a reescribirlo o a revocar el certificado.
*.pfx
*.p12
*.jks
*.pem
*.key
*.crt
.env
.env.*
!.env.example

# === Volcados de datos ===
*.dump
*.sql.gz
*.bak

# === Node / Angular / Astro ===
node_modules/
dist/
.angular/
.astro/
*.tsbuildinfo
coverage/

# === pnpm ===
# El lockfile SÍ va al repositorio: es lo que garantiza que tu máquina y el CI
# instalen exactamente las mismas versiones. Lo mismo pnpm-workspace.yaml, que
# es configuración del monorepo. Aquí solo se excluye lo regenerable.
.pnpm-store/
.pnpm-debug.log*

# Un solo gestor de paquetes. Dos lockfiles conviviendo permiten que el CI
# instale un árbol de dependencias distinto al local sin que nadie lo note,
# y eso solo se descubre cuando falla el despliegue.
package-lock.json
yarn.lock

# === Java / Maven ===
target/
*.class
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# === AWS CDK ===
cdk.out/
cdk.context.json

# === Entornos y herramientas ===
.venv/
__pycache__/
*.pyc

# === Editores ===
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# === Sistema operativo ===
.DS_Store
Thumbs.db
desktop.ini

# === Repositorio independiente ===
ia-skills
